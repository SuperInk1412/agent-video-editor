{
  "format": "vdm.source/1",
  "id": "canvas2d-bars",
  "label": "跳动条（canvas2d 共享夹具）",
  "runtime": "canvas2d",
  "entry": "main.js",
  "deterministic": true,
  "params": [
    {
      "id": "count",
      "label": "条数",
      "group": "shape",
      "type": "int",
      "unit": "",
      "default": 12,
      "range": [3, 32],
      "step": 1,
      "keyable": "frame"
    },
    {
      "id": "speed",
      "label": "速度",
      "group": "motion",
      "type": "number",
      "unit": "",
      "default": 0.9,
      "range": [0, 4],
      "step": 0.05,
      "keyable": "frame"
    },
    {
      "id": "tint",
      "label": "颜色",
      "group": "style",
      "type": "color",
      "default": "#ffd166",
      "keyable": "frame"
    }
  ]
}
