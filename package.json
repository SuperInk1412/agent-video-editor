{
  "name": "vediomaker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-assisted video composer: realtime WebGL preview, Blender render backend, DSH-TUI edit agent",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "web": "node engine/server.js --open",
    "dev": "node scripts/dev.mjs --web",
    "cli": "node cli/vdm.js",
    "mcp": "node mcp/server.js",
    "test": "node scripts/test.mjs",
    "still": "node cli/vdm.js still",
    "blender:check": "node scripts/blender-check.mjs",
    "logs": "node scripts/logs.mjs --project projects/miku-swiss --lines 120 --follow",
    "check:preview": "node scripts/check-preview.mjs",
    "check:evaluate": "node scripts/check-evaluate.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "keywords": [
    "video",
    "blender",
    "timeline",
    "ai",
    "electron"
  ],
  "license": "MIT",
  "main": "app/electron/main.js"
}
