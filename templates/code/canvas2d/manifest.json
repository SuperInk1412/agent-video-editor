{
  "format": "vdm.source/1",
  "id": "src_canvas2d",
  "label": "canvas2d 起步模板",
  "runtime": "canvas2d",
  "entry": "sketch.js",
  "deterministic": true,
  "params": [
    {
      "id": "density",
      "label": "密度",
      "group": "shape",
      "type": "number",
      "unit": "",
      "default": 0.55,
      "range": [0, 1],
      "step": 0.01,
      "keyable": "frame"
    },
    {
      "id": "count",
      "label": "格数",
      "group": "shape",
      "type": "int",
      "default": 10,
      "range": [2, 24],
      "step": 1,
      "keyable": "frame"
    },
    {
      "id": "speed",
      "label": "速度",
      "group": "motion",
      "type": "number",
      "unit": "",
      "default": 0.5,
      "range": [0, 4],
      "step": 0.05,
      "keyable": "frame"
    },
    {
      "id": "tint",
      "label": "颜色",
      "group": "style",
      "type": "color",
      "default": "#66ccff",
      "keyable": "frame"
    }
  ]
}
