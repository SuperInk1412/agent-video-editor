# deps (we ship zero npm dependencies, but electron may be linked in)
node_modules/

# scratch / build outputs
.scratch/
dist/
out/

# per-project generated state: caches, frames, renders, locks
projects/*/.vdm/
projects/*/media/
projects/*/renders/
assets/fonts/
assets/media/

# the published miku-swiss sample ships its one audio cue
!projects/miku-swiss/media/
!projects/miku-swiss/media/**

# local-only working projects (only the miku-swiss sample is published)
/projects/demo/
/projects/nightcity/
/projects/空项目测试/
/projects/未命名项目/
/projects/miku-swiss/tools/
/projects/miku-swiss/.backup-before-rules.json

# editor / os noise
.DS_Store
Thumbs.db
*.log
*.tmp
List.efu

# reference app / design refs (local only)
参考程序/
参考设计/
/给AI的截图/

# python bytecode
__pycache__/
*.pyc
